[
  {
    "id": "k-pods-001",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Lister tous les pods du namespace 'web'.",
    "difficulty": 1,
    "tags": ["pods", "get"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl get pods -n web",
      "explanation": "`get pods` ou `get po` (alias) acceptent `-n <ns>` ou `--namespace=<ns>`.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+get\\s+(pods?|po)\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+get\\s+(pods?|po)$"
      ]
    }
  },
  {
    "id": "k-pods-002",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Lister tous les pods de tous les namespaces avec leur IP et le node sur lequel ils tournent.",
    "difficulty": 2,
    "tags": ["pods", "get", "wide"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl get pods -A -o wide",
      "explanation": "`-A` est l'alias court de `--all-namespaces`. `-o wide` ajoute IP, node, nominated node et readiness gates.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+get\\s+(pods?|po)\\s+(-A|--all-namespaces)\\s+-o\\s+wide$",
        "^(kubectl|k)\\s+get\\s+(pods?|po)\\s+-o\\s+wide\\s+(-A|--all-namespaces)$"
      ]
    }
  },
  {
    "id": "k-pods-003",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Créer un pod nommé 'nginx' avec l'image 'nginx:1.27' dans le namespace 'web'.",
    "difficulty": 1,
    "tags": ["pods", "run", "create"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl run nginx --image=nginx:1.27 -n web",
      "explanation": "`kubectl run` crée un pod (depuis K8s 1.18+, plus un deployment). L'option `--image` est obligatoire.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+run\\s+nginx\\s+--image[= ]nginx:1\\.27\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+run\\s+nginx\\s+--image[= ]nginx:1\\.27$",
        "^(kubectl|k)\\s+run\\s+nginx\\s+(-n\\s+web|--namespace[= ]web)\\s+--image[= ]nginx:1\\.27$"
      ]
    }
  },
  {
    "id": "k-pods-004",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Générer le YAML d'un pod 'tester' image 'busybox' qui exécute 'sleep 3600', sans le créer dans le cluster.",
    "difficulty": 3,
    "tags": ["pods", "run", "dry-run", "yaml"],
    "k8sVersion": "1.31",
    "hints": [
      "Pense à `--dry-run=client` et `-o yaml`.",
      "Sépare les arguments du conteneur après `--`."
    ],
    "challenge": {
      "type": "command",
      "expected": "kubectl run tester --image=busybox --dry-run=client -o yaml -- sleep 3600",
      "explanation": "Astuce d'examen : on génère le manifeste avec `--dry-run=client -o yaml`, on l'édite si besoin, puis `kubectl apply -f`.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+run\\s+tester\\s+--image[= ]busybox\\s+--dry-run=client\\s+-o\\s+yaml\\s+--\\s+sleep\\s+3600$",
        "^(kubectl|k)\\s+run\\s+tester\\s+--image[= ]busybox\\s+-o\\s+yaml\\s+--dry-run=client\\s+--\\s+sleep\\s+3600$"
      ]
    }
  },
  {
    "id": "k-deploy-001",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Créer un deployment 'api' avec 3 réplicas, image 'nginx', dans le namespace 'web'.",
    "difficulty": 2,
    "tags": ["deployment", "create"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl create deployment api --image=nginx --replicas=3 -n web",
      "explanation": "`create deployment` accepte `--replicas` depuis K8s 1.19. Avant, on faisait `create` puis `scale`.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+create\\s+deploy(ment)?\\s+api\\s+--image[= ]nginx\\s+--replicas[= ]3\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+create\\s+deploy(ment)?\\s+api\\s+(-n\\s+web|--namespace[= ]web)\\s+--image[= ]nginx\\s+--replicas[= ]3$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+create\\s+deploy(ment)?\\s+api\\s+--image[= ]nginx\\s+--replicas[= ]3$"
      ]
    }
  },
  {
    "id": "k-deploy-002",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Scaler le deployment 'api' à 5 réplicas dans le namespace 'web'.",
    "difficulty": 1,
    "tags": ["deployment", "scale"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl scale deployment api --replicas=5 -n web",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+scale\\s+deploy(ment)?(/api|\\s+api)\\s+--replicas[= ]5\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+scale\\s+deploy(ment)?(/api|\\s+api)\\s+--replicas[= ]5$"
      ]
    }
  },
  {
    "id": "k-deploy-003",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Mettre à jour l'image du deployment 'api' (conteneur 'api') vers 'nginx:1.27' dans le namespace 'web'.",
    "difficulty": 2,
    "tags": ["deployment", "set", "image"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl set image deployment/api api=nginx:1.27 -n web",
      "explanation": "Utiliser `set image` est plus rapide que `edit` pour ce cas. Format : `<container>=<image>`.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+set\\s+image\\s+deploy(ment)?/api\\s+api=nginx:1\\.27\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+set\\s+image\\s+deploy(ment)?/api\\s+api=nginx:1\\.27$"
      ]
    }
  },
  {
    "id": "k-deploy-004",
    "category": "kubectl",
    "domain": "workloads-scheduling",
    "scenario": "Annuler le dernier rollout du deployment 'api' dans le namespace 'web'.",
    "difficulty": 2,
    "tags": ["deployment", "rollout", "undo"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl rollout undo deployment/api -n web",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+rollout\\s+undo\\s+deploy(ment)?(/api|\\s+api)\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+rollout\\s+undo\\s+deploy(ment)?(/api|\\s+api)$"
      ]
    }
  },
  {
    "id": "k-svc-001",
    "category": "kubectl",
    "domain": "services-networking",
    "scenario": "Exposer le deployment 'api' (port 80) en service ClusterIP nommé 'api' dans le namespace 'web'.",
    "difficulty": 2,
    "tags": ["service", "expose"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl expose deployment api --port=80 -n web",
      "explanation": "`expose` crée un service ClusterIP par défaut. Le nom du service hérite du déploiement sauf si `--name=...`.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+expose\\s+deploy(ment)?(/api|\\s+api)\\s+--port[= ]80\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+expose\\s+deploy(ment)?(/api|\\s+api)\\s+--port[= ]80\\s+--type[= ]ClusterIP\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+expose\\s+deploy(ment)?(/api|\\s+api)\\s+--port[= ]80$"
      ]
    }
  },
  {
    "id": "k-svc-002",
    "category": "kubectl",
    "domain": "services-networking",
    "scenario": "Lister les endpoints du service 'api' dans le namespace 'web'.",
    "difficulty": 2,
    "tags": ["service", "endpoints"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
