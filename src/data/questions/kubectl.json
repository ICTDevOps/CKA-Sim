  {
    "id": "k-troubleshoot-003",
    "category": "kubectl",
    "domain": "troubleshooting",
    "scenario": "Marquer le node 'worker-2' indisponible (drain) en évacuant les pods et en ignorant les daemonsets.",
    "difficulty": 4,
    "tags": ["node", "drain", "troubleshooting"],
    "k8sVersion": "1.31",
    "hints": ["`drain --ignore-daemonsets ...`."],
    "challenge": {
      "type": "command",
      "expected": "kubectl drain worker-2 --ignore-daemonsets",
      "explanation": "Sur un cluster réel, on ajoute souvent `--delete-emptydir-data` et `--force` selon le cas.",
      "acceptedPatterns": [
