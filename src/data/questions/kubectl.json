  {
    "id": "k-rbac-002",
    "category": "kubectl",
    "domain": "cluster-architecture",
    "scenario": "Créer un Role 'reader' qui autorise 'get,list,watch' sur les pods, dans le namespace 'web'.",
    "difficulty": 3,
    "tags": ["rbac", "role"],
    "k8sVersion": "1.31",
    "challenge": {
      "type": "command",
      "expected": "kubectl create role reader --verb=get,list,watch --resource=pods -n web",
      "explanation": "`create role` est un raccourci. Sépare les verbes par des virgules sans espaces.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+create\\s+role\\s+reader\\s+--verb[= ]get,list,watch\\s+--resource[= ]pods?\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+create\\s+role\\s+reader\\s+--verb[= ]get,list,watch\\s+--resource[= ]pods?$"
      ]
