  },
  {
    "id": "k-rbac-003",
    "category": "kubectl",
    "domain": "cluster-architecture",
    "scenario": "Vérifier si le ServiceAccount 'ci' du namespace 'web' peut créer des deployments.",
    "difficulty": 3,
    "tags": ["rbac", "auth"],
    "k8sVersion": "1.31",
    "hints": ["`kubectl auth can-i ...`", "Spécifier `--as=system:serviceaccount:web:ci`."],
