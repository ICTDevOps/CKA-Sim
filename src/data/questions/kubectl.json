      "type": "command",
      "expected": "kubectl auth can-i create deployments --as=system:serviceaccount:web:ci -n web",
      "explanation": "`auth can-i` répond yes/no en prenant en compte tous les Roles/ClusterRoles applicables.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+auth\\s+can-i\\s+create\\s+deploy(ments?)?\\s+--as[= ]system:serviceaccount:web:ci\\s+(-n\\s+web|--namespace[= ]web)$",
        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+auth\\s+can-i\\s+create\\s+deploy(ments?)?\\s+--as[= ]system:serviceaccount:web:ci$"
      ]
    }
