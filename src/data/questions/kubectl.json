        "^(kubectl|k)\\s+(-n\\s+web|--namespace[= ]web)\\s+get\\s+(endpoints|ep)\\s+api$",
        "^(kubectl|k)\\s+get\\s+endpointslices?\\s+(-l|--selector[= ])\\s*kubernetes\\.io/service-name=api\\s+(-n\\s+web|--namespace[= ]web)$"
      ]
    }
  },
