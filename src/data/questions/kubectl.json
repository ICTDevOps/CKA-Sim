  {
    "id": "k-jsonpath-001",
    "category": "kubectl",
    "domain": "other",
    "scenario": "Afficher uniquement les noms des nodes du cluster, un par ligne, en utilisant JSONPath.",
    "difficulty": 4,
    "tags": ["jsonpath", "nodes"],
    "k8sVersion": "1.31",
    "hints": ["`-o jsonpath='{range .items[*]}{.metadata.name}{\"\\n\"}{end}'`"],
    "challenge": {
      "type": "command",
      "expected": "kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{\"\\n\"}{end}'",
      "explanation": "JSONPath est un quasi-incontournable du CKA pour extraire des champs précis.",
      "acceptedPatterns": [
        "^(kubectl|k)\\s+get\\s+nodes?\\s+-o\\s+jsonpath=['\"]\\{range \\.items\\[\\*\\]\\}\\{\\.metadata\\.name\\}\\{[\"']\\\\n[\"']\\}\\{end\\}['\"]$",
        "^(kubectl|k)\\s+get\\s+nodes?\\s+-o\\s+jsonpath=['\"]\\{\\.items\\[\\*\\]\\.metadata\\.name\\}['\"]$"
      ]
    }
  }
]
